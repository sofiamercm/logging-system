# ============================================================
# CONFIGURACION CENTRAL
# ============================================================

# Nombre del bucket S3
export BUCKET="logging"

# Region de AWS
export REGION="us-east-1"
export AWS_DEFAULT_REGION="$REGION"

# Tablas de DynamoDB
export LOGS_TABLE="Logs"
export ALERTS_TABLE="SecurityAlerts"

# Nombres de los recursos
export PARSE_FUNCTION="parse_batch"
export STATE_MACHINE_NAME="log-processing"
export RULE_NAME="log-batch-uploaded"

# Lambda de la clase anterior
export OLD_FUNCTION="logging-system-processor"

# ============================================================
# ROLES IAM - AWS LEARNER LAB
# ============================================================

# Obtener automáticamente el Account ID de las credenciales
# configuradas en la computadora de cada integrante.

ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)

export LAMBDA_ROLE_ARN="arn:aws:iam::${ACCOUNT_ID}:role/LabRole"
export SFN_ROLE_ARN="arn:aws:iam::${ACCOUNT_ID}:role/LabRole"
export EVENTS_ROLE_ARN="arn:aws:iam::${ACCOUNT_ID}:role/LabRole"

# ============================================================
# CARGAR CONFIGURACION
# ============================================================

_CFG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[ -f "${_CFG_DIR}/roles.env" ] && source "${_CFG_DIR}/roles.env"