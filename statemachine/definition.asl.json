{
  "Comment": "Procesa un batch de logs: parsea, clasifica cada linea y la guarda en DynamoDB",
  "StartAt": "ParseBatch",
  "States": {
    "ParseBatch": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${PARSE_BATCH_ARN}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "ProcessLines"
    },
    "ProcessLines": {
      "Type": "Map",
      "ItemsPath": "$.lines",
      "MaxConcurrency": 10,
      "ResultPath": null,
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "IsSuspicious",
        "States": {
          "IsSuspicious": {
            "Type": "Choice",
            "Choices": [
              {
                "Or": [
                  { "Variable": "$.message", "StringMatches": "*Invalid user*" },
                  { "Variable": "$.message", "StringMatches": "*POSSIBLE BREAK-IN ATTEMPT*" }
                ],
                "Next": "WriteSecurityAlert"
              }
            ],
            "Default": "WriteNormalLog"
          },
          "WriteSecurityAlert": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Parameters": {
              "TableName": "${ALERTS_TABLE}",
              "Item": {
                "log_id": { "S.$": "$.log_id" },
                "batch_key": { "S.$": "$.batch_key" },
                "line_number": { "N.$": "States.Format('{}', $.line_number)" },
                "message": { "S.$": "$.message" },
                "classification": { "S": "suspicious" },
                "timestamp": { "S.$": "$.timestamp" },
                "host": { "S.$": "$.host" },
                "log": { "S.$": "$.message" },
                "severity": { "S": "HIGH" },
                "LastModified": { "S.$": "$.LastModified" }
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDB.ProvisionedThroughputExceededException",
                  "DynamoDB.RequestLimitExceeded",
                  "DynamoDB.ThrottlingException",
                  "DynamoDB.InternalServerErrorException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 6,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              },
              {
                "ErrorEquals": ["States.TaskFailed"],
                "IntervalSeconds": 2,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "End": true
          },
          "WriteNormalLog": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Parameters": {
              "TableName": "${LOGS_TABLE}",
              "Item": {
                "log_id": { "S.$": "$.log_id" },
                "batch_key": { "S.$": "$.batch_key" },
                "line_number": { "N.$": "States.Format('{}', $.line_number)" },
                "message": { "S.$": "$.message" },
                "classification": { "S": "normal" },
                "timestamp": { "S.$": "$.timestamp" },
                "host": { "S.$": "$.host" },
                "log": { "S.$": "$.message" },
                "all_logs": { "S": "ALL" },
                "LastModified": { "S.$": "$.LastModified" }
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDB.ProvisionedThroughputExceededException",
                  "DynamoDB.RequestLimitExceeded",
                  "DynamoDB.ThrottlingException",
                  "DynamoDB.InternalServerErrorException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 6,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              },
              {
                "ErrorEquals": ["States.TaskFailed"],
                "IntervalSeconds": 2,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "End": true
          }
        }
      },
      "End": true
    }
  }
}
